# Keep credentials and machine-specific settings out of Git. Native skills/agents,
# shared prompts and redacted evidence remain tracked.

# GitHub MCP configuration (holds your personal access token)
.mcp.json
.vscode/mcp.json
.cursor/mcp.json

# Local Claude Code / Codex configuration — never ignore the whole .claude/ or .codex/ dir
.claude/settings.local.json
.claude/langsmith.json
.codex/config.toml
.codex/auth.json
.codex/langsmith.json

.env
.env.*
!.env.example
.DS_Store
__pycache__/
*.pyc
*.log
